
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Dados do usuário administrador e configurações globais.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "metaAccessToken": { "type": "string" },
        "metaConnected": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "AdAccount": {
      "title": "Ad Account",
      "description": "Conta de anúncio selecionada para monitoramento.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "businessId": { "type": "string" },
        "businessName": { "type": "string" },
        "monitored": { "type": "boolean", "default": true }
      },
      "required": ["accountId", "name"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Dados de performance da campanha.",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "spend": { "type": "number" },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "lastSync": { "type": "string", "format": "date-time" }
      }
    },
    "TrackingEvent": {
      "title": "Tracking Event",
      "description": "Evento capturado pelo Pixel AdPulse.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "visitorId": { "type": "string" },
        "sessionId": { "type": "string" },
        "eventType": { "type": "string" },
        "url": { "type": "string" },
        "utmSource": { "type": "string" },
        "utmMedium": { "type": "string" },
        "utmCampaign": { "type": "string" },
        "fbclid": { "type": "string" },
        "fbp": { "type": "string" },
        "fbc": { "type": "string" },
        "userAgent": { "type": "string" },
        "ipAddress": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Conversion": {
      "title": "Conversion",
      "description": "Venda ou lead registrado no sistema.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "externalId": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "utmSource": { "type": "string" },
        "attributedCampaignId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Configurações do usuário."
    },
    "/users/{userId}/ad_accounts": {
      "schema": "AdAccount",
      "description": "Contas de anúncios monitoradas."
    },
    "/users/{userId}/campaigns": {
      "schema": "Campaign",
      "description": "Campanhas sincronizadas da Meta."
    },
    "/users/{userId}/events": {
      "schema": "TrackingEvent",
      "description": "Eventos de rastreamento do Pixel."
    },
    "/users/{userId}/conversions": {
      "schema": "Conversion",
      "description": "Conversões e vendas registradas."
    }
  }
}
